<div class="mb-4">
    <h2>Sistema de Reservas para tus Eventos Favoritos ADMIN</h2>
    <p class="text-muted">Cancelar Entradas Vencidas</p>
</div>

{{#unless user}}
<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> No tienes permisos para acceder a esta página.
</div>
{{else}}
{{#if (eq user.rol 'NORMAL')}}
<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> Solo administradores pueden cancelar entradas vencidas.
</div>
{{else}}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-lg">
            <div class="card-body text-center p-5">
                <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 4rem;"></i>
                <h3 class="mt-4">Cancelar Entradas Vencidas</h3>
                <p class="text-muted mt-3 mb-4">
                    Esta acción cancelará automáticamente todas las entradas en estado <strong>RESERVADA</strong>
                    cuya fecha de reserva haya expirado (más de 24 horas).
                </p>
                
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> 
                    Las entradas canceladas liberarán las localidades reservadas y volverán disponibles para nuevas reservas.
                </div>
                
                <div id="alertContainer" class="mt-3"></div>
                
                <div class="d-grid gap-2 mt-4">
                    <button id="btnCancelarVencidas" class="btn btn-danger btn-lg">
                        <i class="bi bi-x-circle"></i> Cancelar Entradas Vencidas
                    </button>
                    <a href="/" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{{/if}}
{{/unless}}

<script>
document.getElementById('btnCancelarVencidas')?.addEventListener('click', async () => {
    if (!confirm('¿Estás seguro de cancelar todas las entradas vencidas? Esta acción no se puede deshacer.')) {
        return;
    }
    
    const btn = document.getElementById('btnCancelarVencidas');
    const btnText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Procesando...';
    
    try {
        const response = await fetch('/api/entradas/cancelar-vencidas', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const contentType = response.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) {
            throw new Error('Error del servidor. Por favor, recarga la página.');
        }
        
        const data = await response.json();
        
        if (!response.ok) {
            if (response.status === 401 || response.status === 403) {
                showAlert('error', 'Sesión expirada. Redirigiendo al login...');
                setTimeout(() => window.location.href = '/login', 1500);
                return;
            }
            throw new Error(data.message || 'Error al cancelar entradas');
        }
        
        showAlert('success', `✓ ${data.message}`);
        
    } catch (error) {
        showAlert('error', error.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = btnText;
    }
});

function showAlert(type, message) {
    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const icon = type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill';
    
    const alertHtml = `
        <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
            <i class="bi bi-${icon}"></i> ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    `;
    
    document.getElementById('alertContainer').innerHTML = alertHtml;
}
</script>
