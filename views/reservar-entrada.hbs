<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Realiza la compra de tus entradas!</h4>
            </div>
            <div class="card-body">
                <h5 class="mb-3">{{evento.nombre}} - {{evento.codigo}}</h5>
                
                <div class="alert alert-info mb-3">
                    <i class="bi bi-info-circle"></i> 
                    <strong>Disponibles:</strong> {{disponibles}} localidades
                </div>

                <div id="alertContainer"></div>
                
                <form id="formReserva">
                    <div class="mb-4">
                        <label for="cantidadLocalidades" class="form-label">
                            <strong>Cantidad de Localidades:</strong>
                        </label>
                        <input type="number" 
                               class="form-control" 
                               id="cantidadLocalidades" 
                               name="cantidadLocalidades" 
                               min="1" 
                               max="{{#if disponibles}}{{disponibles}}{{else}}0{{/if}}" 
                               value="{{#if disponibles}}1{{else}}0{{/if}}" 
                               required>
                        <div class="form-text">
                            Máximo {{#if disponibles}}{{disponibles}}{{else}}0{{/if}} localidades disponibles
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg" {{#unless disponibles}}disabled{{/unless}}>
                            <i class="bi bi-check-circle"></i> Confirmar Reserva
                        </button>
                        <a href="/eventos/{{evento.id}}" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('formReserva').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const btn = e.target.querySelector('button[type="submit"]');
    const btnText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Procesando...';
    
    const cantidadLocalidades = parseInt(document.getElementById('cantidadLocalidades').value);
        
    try {
        // La cookie se envía automáticamente con cada request
        const response = await fetch('/api/entradas/reservar', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                eventoId: '{{evento.id}}',
                cantidadLocalidades
            })
        });
        
        const data = await response.json();
        
        if (!response.ok) {
            // Si no está autenticado, redirigir al login
            if (response.status === 401 || response.status === 403) {
                showAlert('error', 'Sesión expirada. Redirigiendo al login...');
                setTimeout(() => window.location.href = '/login', 1500);
                return;
            }
            throw new Error(data.message || 'Error al reservar entrada');
        }
        
        showAlert('success', 'Reserva confirmada! Redirigiendo...');
        setTimeout(() => {
            window.location.href = '/mis-entradas';
        }, 1500);
        
    } catch (error) {
        showAlert('error', error.message);
        btn.disabled = false;
        btn.innerHTML = btnText;
    }
});

function showAlert(type, message) {
    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const icon = type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill';
    
    const alertHtml = `
        <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
            <i class="bi bi-${icon}"></i> ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    `;
    
    document.getElementById('alertContainer').innerHTML = alertHtml;
}
</script>