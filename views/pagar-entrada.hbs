<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-lg mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Realiza el pago de tu reserva para confirmarla!</h4>
            </div>
            <div class="card-body">
                <p class="mb-3">
                    <strong>Evento:</strong> {{evento.nombre}} - {{evento.codigo}}
                </p>
                <p class="mb-3">
                    <strong>Cantidad de Localidades:</strong> {{entrada.cantidadLocalidades}}
                </p>
                <h4 class="mb-4">
                    <strong>Precio Total:</strong> 
                    <span class="text-success">${{precioTotal}}</span>
                </h4>

                <div id="alertContainer"></div>

                <form id="formPago">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-pagar btn-lg">
                            <i class="bi bi-wallet2"></i> Pagar con MercadoPago
                        </button>
                        <a href="/mis-entradas" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('formPago').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (!confirm('¿Confirmar pago de esta entrada?')) {
        return;
    }
    
    const btn = e.target.querySelector('button[type="submit"]');
    const btnText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Procesando pago...';
           
    try {
        // La cookie se envía automáticamente con cada request
        const response = await fetch('/api/entradas/pagar/{{entrada.id}}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        
        if (!response.ok) {
            // Si no está autenticado, redirigir al login
            if (response.status === 401 || response.status === 403) {
                showAlert('error', 'Sesión expirada. Redirigiendo al login...');
                setTimeout(() => window.location.href = '/login', 1500);
                return;
            }
            throw new Error(data.message || 'Error al procesar el pago');
        }
        
        showAlert('success', 'Pago confirmado! Redirigiendo...');
        setTimeout(() => {
            window.location.href = '/mis-entradas';
        }, 1500);
        
    } catch (error) {
        showAlert('error', error.message);
        btn.disabled = false;
        btn.innerHTML = btnText;
    }
});

function showAlert(type, message) {
    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const icon = type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill';
    
    const alertHtml = `
        <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
            <i class="bi bi-${icon}"></i> ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    `;
    
    document.getElementById('alertContainer').innerHTML = alertHtml;
}
</script>